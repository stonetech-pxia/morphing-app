# 复制为 .env 后填写：cp .env.example .env
# .env 已被 git 忽略，绝不能提交。配置说明见 docs/API_KEY_SETUP.md。
#
# 只由服务端（M3 的 apps/api）读取。绝不能出现在手机端代码或以 EXPO_PUBLIC_ 开头的变量中。
# 留空时 App 使用 mock AI，不需要任何 key。

ANTHROPIC_API_KEY=

# 可选：模型（默认 claude-haiku-5-5）、思考力度（low / medium / high）、本机端口与限额
# MORPH_AI_MODEL=claude-haiku-5-5
# MORPH_AI_EFFORT=low
# MORPH_API_PORT=8787
# 每台设备每分钟几次、每天花多少美元，所有设备合计每天花多少美元；一台设备一天几次回复不像修改计划就停用（D-193）
# MORPH_PER_MINUTE_LIMIT=10
# MORPH_DEVICE_DAILY_USD=0.2
# MORPH_GLOBAL_DAILY_USD=2
# MORPH_OFF_PLAN_LIMIT=5
# 每次回复最多多少 token（含思考）
# MORPH_MAX_OUTPUT_TOKENS=16000
# 设置后请求必须带同样的令牌（打包 App 时用 EXPO_PUBLIC_MORPH_CLIENT_TOKEN 传入）。见 docs/DEPLOY.md
# MORPH_CLIENT_TOKEN=
# 测试期保存请求（D-240）：设置后每次转发成功把提示词、用户的话和回复追加到这个文件；不设就不保存
# MORPH_REQUESTS_FILE=data/requests.jsonl

# M3 云端数据（尚未使用）
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
