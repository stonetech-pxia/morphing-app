# 复制为 .env 后填写：cp .env.example .env
# .env 已被 git 忽略，绝不能提交。配置说明见 docs/API_KEY_SETUP.md。
#
# 只由服务端（M3 的 apps/api）读取。绝不能出现在手机端代码或以 EXPO_PUBLIC_ 开头的变量中。
# 留空时 App 使用 mock AI，不需要任何 key。

ANTHROPIC_API_KEY=

# 可选：模型（默认 claude-haiku-5-5）、思考力度（low / medium / high）、本机端口与限额
# MORPH_AI_MODEL=claude-haiku-5-5
# MORPH_AI_EFFORT=low
# MORPH_API_PORT=8787
# 每台设备每分钟 / 每天，以及所有设备合计每天（D-132）
# MORPH_PER_MINUTE_LIMIT=10
# MORPH_DAILY_LIMIT=50
# MORPH_GLOBAL_DAILY_LIMIT=500
# 设置后请求必须带同样的令牌（打包 App 时用 EXPO_PUBLIC_MORPH_CLIENT_TOKEN 传入）。见 docs/DEPLOY.md
# MORPH_CLIENT_TOKEN=
# 下载的工具（D-177）：签名目录所在的地址（不含 catalog.json），App 用 EXPO_PUBLIC_MORPH_TOOLS_URL 传同一个地址。
# MORPH_TOOLS_DEV_KEY=1 时也信任仓库里的开发公钥，只在本机开发时用。见 docs/TOOL_DOWNLOAD_DESIGN.md
# MORPH_TOOLS_URL=
# MORPH_TOOLS_DEV_KEY=

# M3 云端数据（尚未使用）
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
