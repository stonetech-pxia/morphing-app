                "filter": [
                  {
                    "field": "project",
                    "op": "is",
                    "value": "$record"
                  },
                  {
                    "field": "plan",
                    "op": "due",
                    "value": "pending"
                  }
                ],
                "sort": {
                  "field": "plan",
                  "direction": "asc"
                },
                "limit": 20
              },
              "show": {
                "title": "title",
                "subtitles": [
                  "plan"
                ],
                "trailing": "priority",
                "emptyText": "# all clear"
              },
              "tools": [
                {
                  "as": "button",
                  "label": "Done",
                  "do": "create",
                  "table": "completions",
                  "values": {
                    "task": "$row"
                  }
                },
                {
                  "as": "addHere",
                  "do": "create",
                  "table": "tasks",
                  "ask": "all",
                  "values": "$here"
                }
              ],
              "opens": "task"
            }
          ]
        }
      ]
    },
    "tools": [
      {
        "id": "task-due",
        "kind": "reminder",
        "title": "Task due",
        "enabled": true,
        "when": {
          "each": {
            "table": "tasks",
            "field": "plan"
          },
          "at": "09:00"
        },
        "opens": "page:home",
        "done": {
          "do": "create",
          "table": "completions",
          "values": {
            "task": "$row"
          }
        },
        "snoozeMinutes": 30
      },
      {
        "id": "wrap-up",
        "kind": "reminder",
        "title": "Wrap up: what shipped today?",
        "enabled": true,
        "when": {
          "every": "week",
          "days": [
            1,
            2,
            3,
            4,
            5
          ],
          "at": "17:30"
        },
        "opens": "page:home"
      }
    ],
    "packages": []
  }
}