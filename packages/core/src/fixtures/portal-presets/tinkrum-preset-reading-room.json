{
  "format": "morph-app-config",
  "version": 1,
  "exportedAt": "2026-11-07T11:00:00.000Z",
  "config": {
    "schemaVersion": 37,
    "theme": {
      "primaryColor": "#B3261E",
      "mode": "light",
      "colors": {
        "background": "#FAF7F0",
        "surface": "#FFFDF8",
        "text": "#1A1A1A",
        "secondary": "#2F4A3A",
        "tertiary": "#8A6D3B"
      },
      "font": "serif",
      "fontScale": 1.1,
      "radius": 2,
      "density": "spacious",
      "cardStyle": "outline",
      "navStyle": "label"
    },
    "nav": {
      "bar": [
        "page:home",
        "page:shelf",
        "page:quotes",
        "ai",
        "settings"
      ],
      "floating": []
    },
    "data": {
      "tables": [
        {
          "id": "books",
          "name": "Books",
          "icon": "📚",
          "readAttachments": false,
          "fields": [
            {
              "id": "title",
              "name": "Title",
              "type": "text",
              "required": true
            },
            {
              "id": "author",
              "name": "Author",
              "type": "text"
            },
            {
              "id": "genre",
              "name": "Genre",
              "type": "choice",
              "options": [
                {
                  "id": "fiction",
                  "label": "Fiction"
                },
                {
                  "id": "essays",
                  "label": "Essays"
                },
                {
                  "id": "history",
                  "label": "History"
                },
                {
                  "id": "science",
                  "label": "Science"
                },
                {
                  "id": "poetry",
                  "label": "Poetry"
                }
              ]
            },
            {
              "id": "format",
              "name": "Format",
              "type": "choice",
              "options": [
                {
                  "id": "paper",
                  "label": "Paperback"
                },
                {
                  "id": "ebook",
                  "label": "E-book"
                },
                {
                  "id": "audio",
                  "label": "Audiobook"
                }
              ]
            },
            {
              "id": "pages",
              "name": "Pages",
              "type": "number",
              "decimals": 0
            },
            {
              "id": "read",
              "name": "Pages read",
              "type": "number",
              "decimals": 0,
              "default": 0
            },
            {
              "id": "started",
              "name": "Started",
              "type": "date"
            },
            {
              "id": "finished",
              "name": "Finished",
              "type": "date"
            },
            {
              "id": "rating",
              "name": "Rating",
              "type": "rating"
            },
            {
              "id": "tags",
              "name": "Tags",
              "type": "tags"
            },
            {
              "id": "review",
              "name": "Review",
              "type": "note"
            },
            {
              "id": "cover",
              "name": "Cover",
              "type": "file"
            },
            {
              "id": "left",
              "name": "Pages left",
              "type": "formula",
              "expression": "{pages} - {read}",
              "decimals": 0,
              "unit": "left"
            },
            {
              "id": "pace",
              "name": "Pages per day",
              "type": "formula",
              "expression": "round({pages} / max(days({started}, {finished}), 1), 0)",
              "decimals": 0,
              "unit": "pp/day"
            }
          ]
        },
        {
          "id": "sessions",
          "name": "Reading log",
          "icon": "⏱️",
          "fields": [
            {
              "id": "date",
              "name": "Date",
              "type": "date",
              "default": "today"
            },
            {
              "id": "minutes",
              "name": "Time read",
              "type": "duration"
            },
            {
              "id": "pages",
              "name": "Pages",
              "type": "number",
              "decimals": 0,
              "unit": "pp"
            }
          ]
        },
        {
          "id": "quotes",
          "name": "Quotes",
          "icon": "💬",
          "fields": [
            {
              "id": "quote",
              "name": "Quote",
              "type": "note",
              "required": true
            },
            {
              "id": "book",
              "name": "Book",
              "type": "text"
            },
            {
              "id": "page",
              "name": "Page",
              "type": "number",
              "decimals": 0,
              "unit": "p."
            },
            {
              "id": "saved",
              "name": "Saved on",
              "type": "date",
              "default": "today"
            },
            {
              "id": "tags",
              "name": "Tags",
              "type": "tags"
            }
          ]
        }
      ]
    },
    "containers": {
      "pages": [
        {
          "id": "home",
          "title": "Reading",
          "icon": "home",
          "blocks": [
            {
              "id": "h",
              "look": "header",
              "show": {
                "title": "The Reading Room",
                "subtitle": "Your shelf, at your pace"
              }
            },
            {
              "id": "goal",
              "look": "number",
              "style": {
                "tone": "tertiary"
              },
              "show": {
                "label": "Books finished this year"
              },
              "source": {
                "table": "books",
                "aggregate": "count",
                "filter": [
                  {
                    "field": "finished",
                    "op": "inPeriod",
                    "value": "thisYear"
                  }
                ],
                "goal": 20,
                "compare": "previous"
              }
            },
            {
              "id": "nums",
              "look": "group",
              "show": {
                "layout": "row"
              },
              "children": [
                {
                  "id": "streak",
                  "look": "number",
                  "style": {
                    "tone": "secondary"
                  },
                  "show": {
                    "label": "Reading streak"
                  },
                  "source": {
                    "table": "sessions",
                    "aggregate": "streak",
                    "days": {
                      "date": "date"
                    }
                  }
                },
                {
                  "id": "avg",
                  "look": "number",
                  "style": {
                    "tone": "tertiary"
                  },
                  "show": {
                    "label": "Avg. rating"
                  },
                  "source": {
                    "table": "books",
                    "aggregate": "avg",
                    "field": "rating"
                  }
                }
              ]
            },
            {
              "id": "now-group",
              "look": "group",
              "show": {
                "title": "Reading now · tap to log progress",
                "layout": "stack"
              },
              "children": [
                {
                  "id": "now",
                  "look": "tiles",
                  "source": {
                    "table": "books",
                    "filter": [
                      {
                        "field": "started",
                        "op": "isNotEmpty"
                      },
                      {
                        "field": "finished",
                        "op": "isEmpty"
                      }
                    ],
                    "sort": {
                      "field": "started",
                      "direction": "desc"
                    },
                    "limit": 6
                  },
                  "show": {
                    "title": "title",
                    "trailing": "read",
                    "format": {
                      "kind": "progress",
                      "goal": "pages",
                      "style": "ring"
                    },
                    "emptyText": "Nothing on the nightstand. Start a book from the shelf."
                  },
                  "tools": [
                    {
                      "as": "tap",
                      "label": "+25 pages",
                      "do": "increment",
                      "table": "books",
                      "field": "read",
                      "by": 25,
                      "when": [
                        {
                          "field": "started",
                          "op": "isNotEmpty"
                        },
                        {
                          "field": "finished",
                          "op": "isEmpty"
                        },
                        {
                          "field": "left",
                          "op": "gt",
                          "value": 0
                        }
                      ]
                    },
                    {
                      "as": "tap",
                      "label": "Finish",
                      "do": "set",
                      "table": "books",
                      "field": "finished",
                      "value": "today",
                      "when": [
                        {
                          "field": "started",
                          "op": "isNotEmpty"
                        },
                        {
                          "field": "finished",
                          "op": "isEmpty"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "log",
              "look": "group",
              "show": {
                "layout": "row"
              },
              "children": [
                {
                  "id": "log20",
                  "look": "button",
                  "show": {
                    "label": "Log 20 min",
                    "variant": "filled",
                    "icon": "plus"
                  },
                  "tools": [
                    {
                      "do": "create",
                      "table": "sessions",
                      "values": {
                        "date": "today",
                        "minutes": 20
                      }
                    }
                  ]
                },
                {
                  "id": "logmore",
                  "look": "button",
                  "show": {
                    "label": "Log a session",
                    "variant": "outline"
                  },
                  "tools": [
                    {
                      "do": "create",
                      "table": "sessions",
                      "ask": "all"
                    }
                  ]
                }
              ]
            },
            {
              "id": "days",
              "look": "calendar",
              "source": {
                "table": "sessions",
                "group": {
                  "unit": "day",
                  "by": "date"
                }
              },
              "show": {
                "title": "minutes",
                "subtitles": [
                  "pages"
                ],
                "emptyText": "No reading logged this day."
              }
            },
            {
              "id": "nums2",
              "look": "group",
              "show": {
                "layout": "row"
              },
              "children": [
                {
                  "id": "pace",
                  "look": "number",
                  "style": {
                    "tone": "secondary"
                  },
                  "show": {
                    "label": "Pace"
                  },
                  "source": {
                    "table": "books",
                    "aggregate": "avg",
                    "field": "pace",
                    "filter": [
                      {
                        "field": "finished",
                        "op": "inPeriod",
                        "value": "thisYear"
                      }
                    ]
                  }
                },
                {
                  "id": "pages-year",
                  "look": "number",
                  "style": {
                    "tone": "tertiary"
                  },
                  "show": {
                    "label": "Pages this year"
                  },
                  "source": {
                    "table": "books",
                    "aggregate": "sum",
                    "field": "pages",
                    "filter": [
                      {
                        "field": "finished",
                        "op": "inPeriod",
                        "value": "thisYear"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "week",
              "look": "chart",
              "style": {
                "tone": "primary"
              },
              "show": {
                "kind": "bar",
                "title": "Time read per week"
              },
              "source": {
                "table": "sessions",
                "aggregate": "sum",
                "field": "minutes",
                "group": {
                  "unit": "week",
                  "by": "date",
                  "last": 8
                }
              }
            },
            {
              "id": "pm",
              "look": "chart",
              "show": {
                "kind": "bar",
                "title": "Pages finished per month"
              },
              "source": {
                "table": "books",
                "aggregate": "sum",
                "field": "pages",
                "group": {
                  "by": "finished",
                  "unit": "month",
                  "last": 6
                }
              }
            },
            {
              "id": "pie",
              "look": "chart",
              "show": {
                "kind": "pie",
                "title": "By genre"
              },
              "source": {
                "table": "books",
                "aggregate": "count",
                "filter": [
                  {
                    "field": "finished",
                    "op": "isNotEmpty"
                  }
                ],
                "group": {
                  "by": "genre"
                }
              }
            }
          ]
        },
        {
          "id": "shelf",
          "title": "Shelf",
          "icon": "bookmark",
          "blocks": [
            {
              "id": "h",
              "look": "header",
              "show": {
                "title": "Shelf"
              }
            },
            {
              "id": "add",
              "look": "button",
              "show": {
                "label": "Add a book",
                "variant": "filled",
                "icon": "plus"
              },
              "tools": [
                {
                  "do": "create",
                  "table": "books",
                  "ask": "all"
                }
              ]
            },
            {
              "id": "reading-group",
              "look": "group",
              "show": {
                "title": "Reading",
                "layout": "stack"
              },
              "children": [
                {
                  "id": "reading",
                  "look": "cards",
                  "source": {
                    "table": "books",
                    "filter": [
                      {
                        "field": "started",
                        "op": "isNotEmpty"
                      },
                      {
                        "field": "finished",
                        "op": "isEmpty"
                      }
                    ],
                    "sort": {
                      "field": "started",
                      "direction": "desc"
                    },
                    "limit": 6
                  },
                  "show": {
                    "title": "title",
                    "subtitles": [
                      "author",
                      "left"
                    ],
                    "emptyText": "Nothing in progress."
                  },
                  "tools": [
                    {
                      "as": "button",
                      "label": "+25 pages",
                      "do": "increment",
                      "table": "books",
                      "field": "read",
                      "by": 25,
                      "when": [
                        {
                          "field": "started",
                          "op": "isNotEmpty"
                        },
                        {
                          "field": "finished",
                          "op": "isEmpty"
                        },
                        {
                          "field": "left",
                          "op": "gt",
                          "value": 0
                        }
                      ]
                    },
                    {
                      "as": "button",
                      "label": "Finish",
                      "do": "set",
                      "table": "books",
                      "field": "finished",
                      "value": "today",
                      "when": [
                        {
                          "field": "started",
                          "op": "isNotEmpty"
                        },
                        {
                          "field": "finished",
                          "op": "isEmpty"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "next-group",
              "look": "group",
              "show": {
                "title": "Want to read",
                "layout": "stack"
              },
              "children": [
                {
                  "id": "next",
                  "look": "list",
                  "source": {
                    "table": "books",
                    "filter": [
                      {
                        "field": "started",
                        "op": "isEmpty"
                      },
                      {
                        "field": "finished",
                        "op": "isEmpty"
                      }
                    ],
                    "sort": {
                      "field": "title",
                      "direction": "asc"
                    },
                    "limit": 6
                  },
                  "show": {
                    "title": "title",
                    "subtitles": [
                      "author",
                      "pages"
                    ],
                    "emptyText": "Your wish list is empty."
                  },
                  "tools": [
                    {
                      "as": "button",
                      "label": "Start",
                      "do": "set",
                      "table": "books",
                      "field": "started",
                      "value": "today",
                      "when": [
                        {
                          "field": "started",
                          "op": "isEmpty"
                        },
                        {
                          "field": "finished",
                          "op": "isEmpty"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "done-group",
              "look": "group",
              "show": {
                "title": "Finished",
                "layout": "stack"
              },
              "children": [
                {
                  "id": "done",
                  "look": "list",
                  "source": {
                    "table": "books",
                    "filter": [
                      {
                        "field": "finished",
                        "op": "isNotEmpty"
                      }
                    ],
                    "sort": {
                      "field": "finished",
                      "direction": "desc"
                    },
                    "limit": 5
                  },
                  "show": {
                    "title": "title",
                    "subtitles": [
                      "author",
                      "genre"
                    ],
                    "trailing": "rating",
                    "browse": {
                      "search": true,
                      "sort": [
                        "finished",
                        "rating",
                        "pages",
                        "title"
                      ],
                      "filter": [
                        "genre",
                        "format",
                        "tags"
                      ],
                      "period": "finished"
                    }
                  },
                  "tools": [
                    {
                      "as": "list",
                      "tool": "export-books"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "quotes",
          "title": "Quotes",
          "icon": "text",
          "blocks": [
            {
              "id": "h",
              "look": "header",
              "show": {
                "title": "Quotes"
              }
            },
            {
              "id": "capture",
              "look": "action",
              "show": {
                "shape": "row"
              },
              "tools": [
                {
                  "tool": "capture-quote"
                }
              ]
            },
            {
              "id": "add",
              "look": "button",
              "show": {
                "label": "Add a quote",
                "variant": "outline",
                "icon": "plus"
              },
              "tools": [
                {
                  "do": "create",
                  "table": "quotes",
                  "ask": "all"
                }
              ]
            },
            {
              "id": "list",
              "look": "cards",
              "source": {
                "table": "quotes",
                "sort": {
                  "field": "saved",
                  "direction": "desc"
                },
                "limit": 6
              },
              "show": {
                "title": "quote",
                "subtitles": [
                  "book",
                  "page"
                ],
                "emptyText": "No quotes yet. Capture a line you love.",
                "browse": {
                  "search": true,
                  "sort": [
                    "saved",
                    "page"
                  ],
                  "period": "saved"
                }
              }
            }
          ]
        }
      ]
    },
    "tools": [
      {
        "id": "capture-quote",
        "kind": "quickAction",
        "name": "Capture a quote",
        "icon": "scan",
        "steps": [
          {
            "id": "shoot",
            "action": "in.photos",
            "params": {
              "source": "camera",
              "min": 1,
              "max": 1
            }
          },
          {
            "id": "read",
            "action": "ocr.recognize",
            "params": {
              "lang": "auto"
            }
          },
          {
            "id": "save",
            "action": "out.addRecord",
            "params": {
              "collectionId": "quotes"
            }
          }
        ]
      },
      {
        "id": "export-books",
        "kind": "quickAction",
        "name": "Export books",
        "icon": "share",
        "steps": [
          {
            "id": "xlsx",
            "action": "records.toExcel",
            "params": {}
          },
          {
            "id": "share",
            "action": "out.share",
            "params": {}
          }
        ]
      },
      {
        "id": "evening-read",
        "kind": "reminder",
        "title": "Time for a few pages",
        "enabled": true,
        "when": {
          "every": "day",
          "at": "21:00"
        },
        "opens": "page:home"
      }
    ],
    "packages": []
  }
}