          "type": "choice",
          "options": [
            {
              "id": "p1",
              "label": "P1"
            },
            {
              "id": "p2",
              "label": "P2"
            },
            {
              "id": "p3",
              "label": "P3"
            },
            {
              "id": "p4",
              "label": "P4"
            }
          ],
          "default": "p4"
        },
        {
          "id": "labels",
          "name": "Labels",
          "type": "tags"
        },
        {
          "id": "plan",
          "name": "When",
          "type": "schedule",
          "default": {
            "repeat": "once"
          },
          "lastDone": "last",
          "countEarly": true
        },
        {
          "id": "last",
          "name": "Last done",
          "type": "rollup",
          "table": "focus-completions",
          "via": "task",
          "aggregate": "latest",
          "field": "date"
        }
      ]
    },
    {
      "id": "focus-completions",
      "name": "Completed",
      "icon": "✅",
      "fields": [
        {
          "id": "task",
          "name": "Task",
          "required": true,
          "type": "link",
          "table": "focus-tasks"
        },
        {
          "id": "date",
          "name": "Done on",
          "type": "date",
          "default": "today"
        }
      ]
    },
    {
      "id": "focus-focus",
      "name": "Focus sessions",
      "icon": "⏱",
      "fields": [
        {
          "id": "task",
          "name": "Task",
          "type": "link",
          "table": "focus-tasks"
        },
        {
          "id": "started",
          "name": "Started",
          "type": "datetime",
          "default": "now"
        },
        {
          "id": "ended",
          "name": "Ended",
          "type": "datetime"
        },
        {
          "id": "hours",
          "name": "Focused",
          "type": "formula",
          "expression": "hours({started}, {ended})",
          "decimals": 1,
          "unit": "h"
        }
      ]
    }
  ],
  "tools": [
    {
      "id": "focus-task-due",
      "kind": "reminder",
      "title": "Task due",
      "enabled": true,
      "when": {
        "each": {
          "table": "focus-tasks",
          "field": "plan"
        },
        "at": "09:00"
      },
      "opens": "page:focus-home",
      "done": {
        "do": "create",
        "table": "focus-completions",
        "values": {
          "task": "$row"
        }
      },
      "snoozeMinutes": 30
    },
    {
      "id": "focus-wrap-up",
      "kind": "reminder",
      "title": "Wrap up: what shipped today?",
      "enabled": true,
      "when": {
        "every": "week",
        "days": [
          1,
          2,
          3,
          4,
          5
        ],
        "at": "17:30"
      },
      "opens": "page:focus-home"
    }
  ]
}