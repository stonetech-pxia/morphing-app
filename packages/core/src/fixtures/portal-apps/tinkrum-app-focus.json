        {
          "id": "h",
          "look": "header",
          "show": {
            "title": "~/focus",
            "subtitle": "$ git log --since=today"
          }
        },
        {
          "id": "start",
          "showIf": {
            "table": "focus-tasks",
            "has": "none"
          },
          "look": "notice",
          "show": {
            "title": "# empty",
            "text": "Tap + to add a task. Give it a day or a repeat rule; tap Done to log it and it moves on. Start focus runs a timer.",
            "icon": "lightbulb"
          }
        },
        {
          "id": "n1",
          "look": "number",
          "show": {
            "label": "done today"
          },
          "source": {
            "table": "focus-completions",
            "aggregate": "count",
            "filter": [
              {
                "field": "date",
                "op": "inPeriod",
                "value": "today"
              }
            ],
            "goal": 5
          }
        },
        {
          "id": "nums",
          "look": "group",
          "show": {
            "layout": "row"
