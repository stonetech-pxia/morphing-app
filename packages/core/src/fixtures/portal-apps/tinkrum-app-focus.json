                  {
                    "field": "started",
                    "op": "inPeriod",
                    "value": "today"
                  }
                ],
                "compare": "previous"
              }
            },
            {
              "id": "n3",
              "style": {
                "tone": "tertiary"
              },
              "look": "number",
