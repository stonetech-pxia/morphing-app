        {
          "id": "runbox",
          "look": "group",
          "show": {
            "title": "running",
            "layout": "stack"
          },
          "children": [
            {
              "id": "run",
              "look": "list",
              "source": {
                "table": "focus-focus",
                "filter": [
                  {
                    "field": "ended",
                    "op": "isEmpty"
                  }
                ],
                "sort": {
                  "field": "started",
                  "direction": "desc"
                },
                "limit": 3
              },
              "show": {
                "title": "task",
                "subtitles": [
                  "started"
                ],
                "trailing": "started",
                "format": {
                  "kind": "elapsed"
                },
                "emptyText": "# no timer running"
              },
              "tools": [
                {
                  "as": "button",
                  "label": "Stop",
