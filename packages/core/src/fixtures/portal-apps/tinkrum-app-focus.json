  "tables": [
    {
      "id": "focus-projects",
      "name": "Projects",
      "icon": "📁",
      "fields": [
        {
          "id": "name",
          "name": "Project",
          "required": true,
          "type": "text"
        },
        {
          "id": "total",
          "name": "Tasks",
          "type": "rollup",
          "table": "focus-tasks",
          "via": "project",
          "aggregate": "count"
        },
        {
          "id": "done",
          "name": "Done",
          "type": "rollup",
          "table": "focus-tasks",
          "via": "project",
          "aggregate": "count",
          "filter": [
            {
              "field": "last",
              "op": "isNotEmpty"
            }
          ]
        },
        {
          "id": "open",
          "name": "Open",
          "type": "formula",
          "expression": "{total} - {done}",
          "decimals": 0,
          "unit": "open"
        }
      ]
    },
    {
      "id": "focus-tasks",
      "name": "Tasks",
      "icon": "⌨️",
      "fields": [
        {
          "id": "title",
          "name": "Task",
          "required": true,
          "type": "text"
        },
        {
          "id": "project",
          "name": "Project",
          "type": "link",
          "table": "focus-projects"
        },
        {
          "id": "priority",
