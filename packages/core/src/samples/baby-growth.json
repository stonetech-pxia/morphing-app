{
  "icon": "heart",
  "name": {
    "en": "Baby’s growth",
    "zh": "宝宝成长",
    "fr": "Croissance de bébé"
  },
  "summary": {
    "en": "Height and weight charts, a growth log with photos, and quick actions to share photos and videos with family.",
    "zh": "身高体重折线图、带照片的成长记录，照片视频一键发给家人。",
    "fr": "Courbes de taille et de poids, un journal de croissance avec photos, et des actions rapides pour partager photos et vidéos en famille."
  },
  "ids": {
    "$table.growth": "growth",
    "$page.main": "baby",
    "$tool.photoLog": "growth-photo-log",
    "$tool.weekly": "weekly-measure"
  },
  "tables": [
    {
      "id": "$table.growth",
      "name": {
        "en": "Growth",
        "zh": "成长记录",
        "fr": "Croissance"
      },
      "icon": "heart",
      "fields": [
        {
          "id": "date",
          "name": {
            "en": "Date",
            "zh": "日期",
            "fr": "Date"
          },
          "type": "date",
          "default": "today",
          "required": true
        },
        {
          "id": "height",
          "name": {
            "en": "Height",
            "zh": "身高",
            "fr": "Taille"
          },
          "type": "number",
          "decimals": 1,
          "unit": "cm"
        },
        {
          "id": "weight",
          "name": {
            "en": "Weight",
            "zh": "体重",
            "fr": "Poids"
          },
          "type": "number",
          "decimals": 2,
          "unit": "kg"
        },
        {
          "id": "photo",
          "name": {
            "en": "Photo",
            "zh": "照片",
            "fr": "Photo"
          },
          "type": "file"
        },
        {
          "id": "note",
          "name": {
            "en": "Little news",
            "zh": "这次的小变化",
            "fr": "Petite nouveauté"
          },
          "type": "text"
        }
      ]
    }
  ],
  "tools": [
    {
      "id": "$tool.photoLog",
      "kind": "quickAction",
      "name": {
        "en": "Add a photo to the growth log",
        "zh": "选一张照片记成长",
        "fr": "Ajouter une photo au journal"
      },
      "icon": "photo",
      "steps": [
        {
          "id": "pick",
          "action": "in.photos",
          "params": {
            "source": "library",
            "min": 1,
            "max": 1
          }
        },
        {
          "id": "log",
          "action": "out.addRecord",
          "params": {
            "collectionId": "$table.growth"
          }
        }
      ]
    },
    {
      "id": "$tool.send",
      "preset": "send-photos"
    },
    {
      "id": "$tool.oldPhotos",
      "preset": "old-photos"
    },
    {
      "id": "$tool.videoSmaller",
      "preset": "video-too-big"
    },
    {
      "id": "$tool.joinVideos",
      "preset": "join-videos"
    },
    {
      "id": "$tool.weekly",
      "kind": "reminder",
      "title": {
        "en": "Time to measure your baby’s height and weight",
        "zh": "该给宝宝量身高体重了",
        "fr": "C’est le moment de mesurer la taille et le poids de bébé"
      },
      "enabled": true,
      "when": {
        "every": "week",
        "days": [7],
        "at": "10:00"
      },
      "opens": "page:$page.main"
    }
  ],
  "pages": [
    {
      "id": "$page.main",
      "title": {
        "en": "Baby",
        "zh": "宝宝",
        "fr": "Bébé"
      },
      "icon": "heart",
      "backdrop": {
        "overlay": "medium"
      },
      "blocks": [
        {
          "id": "title",
          "look": "header",
          "show": {
            "title": {
              "en": "Baby’s growth",
              "zh": "宝宝成长",
              "fr": "Croissance de bébé"
            },
            "subtitle": {
              "en": "Measure once a week and watch your little one grow.",
              "zh": "每周量一次，看着宝宝一点点长大。",
              "fr": "Mesurez une fois par semaine et regardez votre bébé grandir."
            }
          }
        },
        {
          "id": "add",
          "look": "button",
          "show": {
            "label": {
              "en": "Log a measurement",
              "zh": "记一次",
              "fr": "Noter une mesure"
            },
            "variant": "filled"
          },
          "tools": [
            {
              "do": "create",
              "table": "$table.growth",
              "ask": "all"
            }
          ]
        },
        {
          "id": "run-photo-log",
          "look": "action",
          "show": {
            "shape": "row"
          },
          "tools": [
            {
              "tool": "$tool.photoLog"
            }
          ]
        },
        {
          "id": "weight-chart",
          "look": "chart",
          "show": {
            "kind": "line",
            "title": {
              "en": "Weight (kg)",
              "zh": "体重（kg）",
              "fr": "Poids (kg)"
            }
          },
          "source": {
            "table": "$table.growth",
            "aggregate": "avg",
            "field": "weight",
            "group": {
              "by": "date",
              "unit": "month",
              "last": 12
            }
          }
        },
        {
          "id": "height-chart",
          "look": "chart",
          "show": {
            "kind": "line",
            "title": {
              "en": "Height (cm)",
              "zh": "身高（cm）",
              "fr": "Taille (cm)"
            }
          },
          "source": {
            "table": "$table.growth",
            "aggregate": "avg",
            "field": "height",
            "group": {
              "by": "date",
              "unit": "month",
              "last": 12
            }
          }
        },
        {
          "id": "log",
          "look": "list",
          "source": {
            "table": "$table.growth",
            "sort": {
              "field": "date",
              "direction": "desc"
            },
            "limit": 50
          },
          "show": {
            "title": "date",
            "subtitles": ["height", "weight"],
            "trailing": "note",
            "emptyText": {
              "en": "Log the first measurement to start the charts.",
              "zh": "记下第一次身高体重，折线图就开始画了。",
              "fr": "Notez la première mesure pour démarrer les courbes."
            }
          }
        },
        {
          "id": "actions",
          "look": "group",
          "show": {
            "title": {
              "en": "Photos and videos",
              "zh": "照片和视频",
              "fr": "Photos et vidéos"
            },
            "layout": "grid",
            "columns": 2
          },
          "children": [
            {
              "id": "run-send",
              "look": "action",
              "show": {
                "shape": "tile"
              },
              "tools": [
                {
                  "tool": "$tool.send"
                }
              ]
            },
            {
              "id": "run-old-photos",
              "look": "action",
              "show": {
                "shape": "tile"
              },
              "tools": [
                {
                  "tool": "$tool.oldPhotos"
                }
              ]
            },
            {
              "id": "run-video-smaller",
              "look": "action",
              "show": {
                "shape": "tile"
              },
              "tools": [
                {
                  "tool": "$tool.videoSmaller"
                }
              ]
            },
            {
              "id": "run-join-videos",
              "look": "action",
              "show": {
                "shape": "tile"
              },
              "tools": [
                {
                  "tool": "$tool.joinVideos"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "main": "$page.main",
  "entry": "nav"
}
