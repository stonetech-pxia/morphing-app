{
  "icon": "person",
  "name": {
    "en": "Visa and passport",
    "zh": "出国办证",
    "fr": "Visa et passeport"
  },
  "summary": {
    "en": "A checklist of papers to prepare, expiry dates for your IDs, ID photos and translations.",
    "zh": "要备的材料打勾清单、证件到期提醒，还有证件照、材料包和翻译。",
    "fr": "Une liste des pièces à préparer, les dates d’expiration de vos papiers, des photos d’identité et des traductions."
  },
  "ids": {
    "$table.checklist": "papers",
    "$table.documents": "id-documents",
    "$page.main": "visa",
    "$page.ids": "my-ids",
    "$tool.scanPaper": "scan-paper-log",
    "$tool.expiry": "id-expiry",
    "$tool.deadline": "paper-deadline"
  },
  "tables": [
    {
      "id": "$table.checklist",
      "name": {
        "en": "Papers to prepare",
        "zh": "材料清单",
        "fr": "Pièces à préparer"
      },
      "icon": "check",
      "fields": [
        {
          "id": "name",
          "name": {
            "en": "Paper",
            "zh": "材料",
            "fr": "Pièce"
          },
          "type": "text",
          "required": true
        },
        {
          "id": "ready",
          "name": {
            "en": "Ready",
            "zh": "已备好",
            "fr": "Prête"
          },
          "type": "checkbox"
        },
        {
          "id": "due",
          "name": {
            "en": "Deadline",
            "zh": "截止日期",
            "fr": "Date limite"
          },
          "type": "date"
        },
        {
          "id": "file",
          "name": {
            "en": "Attachment",
            "zh": "附件",
            "fr": "Pièce jointe"
          },
          "type": "file"
        }
      ]
    },
    {
      "id": "$table.documents",
      "name": {
        "en": "My IDs",
        "zh": "证件",
        "fr": "Mes papiers"
      },
      "icon": "person",
      "fields": [
        {
          "id": "name",
          "name": {
            "en": "Document",
            "zh": "证件",
            "fr": "Document"
          },
          "type": "text",
          "required": true
        },
        {
          "id": "expires",
          "name": {
            "en": "Expires on",
            "zh": "到期日",
            "fr": "Expire le"
          },
          "type": "date"
        }
      ]
    }
  ],
  "tools": [
    {
      "id": "$tool.scanPaper",
      "kind": "quickAction",
      "name": {
        "en": "Scan a paper into the checklist",
        "zh": "扫描材料记进清单",
        "fr": "Numériser une pièce dans la liste"
      },
      "icon": "scan",
      "steps": [
        {
          "id": "pick",
          "action": "in.photos",
          "params": {
            "source": "scanner",
            "min": 1,
            "max": 10
          }
        },
        {
          "id": "edges",
          "action": "scan.detect",
          "params": {}
        },
        {
          "id": "log",
          "action": "out.addRecord",
          "params": {
            "collectionId": "$table.checklist"
          }
        }
      ]
    },
    {
      "id": "$tool.photo",
      "preset": "visa-photo"
    },
    {
      "id": "$tool.printPhotos",
      "preset": "print-id-photos"
    },
    {
      "id": "$tool.packet",
      "preset": "document-packet"
    },
    {
      "id": "$tool.toEnglish",
      "preset": "papers-to-english"
    },
    {
      "id": "$tool.foreignPdf",
      "preset": "foreign-pdf"
    },
    {
      "id": "$tool.expiry",
      "kind": "reminder",
      "title": {
        "en": "A document expires soon. Time to renew it.",
        "zh": "证件快到期了，记得去续办",
        "fr": "Un document expire bientôt. Pensez à le renouveler."
      },
      "enabled": true,
      "when": {
        "before": {
          "table": "$table.documents",
          "field": "expires"
        },
        "days": 30,
        "at": "09:00"
      },
      "opens": "page:$page.ids"
    },
    {
      "id": "$tool.deadline",
      "kind": "reminder",
      "title": {
        "en": "A paper is due in 3 days",
        "zh": "有材料 3 天后截止",
        "fr": "Une pièce est à rendre dans 3 jours"
      },
      "enabled": true,
      "when": {
        "before": {
          "table": "$table.checklist",
          "field": "due"
        },
        "days": 3,
        "at": "09:00"
      },
      "opens": "page:$page.main"
    }
  ],
  "pages": [
    {
      "id": "$page.main",
      "title": {
        "en": "Visa",
        "zh": "办证",
        "fr": "Visa"
      },
      "icon": "person",
      "blocks": [
        {
          "id": "title",
          "look": "header",
          "show": {
            "title": {
              "en": "Visa and passport",
              "zh": "出国办证",
              "fr": "Visa et passeport"
            },
            "subtitle": {
              "en": "Tick off each paper as it is ready. Morph reminds you before deadlines.",
              "zh": "材料一项项备好打勾，截止日期前 Morph 会提醒你。",
              "fr": "Cochez chaque pièce dès qu’elle est prête. Morph vous prévient avant les dates limites."
            }
          }
        },
        {
          "id": "left",
          "look": "number",
          "show": {
            "label": {
              "en": "Papers still missing",
              "zh": "还差几项",
              "fr": "Pièces manquantes"
            }
          },
          "source": {
            "table": "$table.checklist",
            "aggregate": "count",
            "filter": [
              {
                "field": "ready",
                "op": "is",
                "value": false
              }
            ]
          }
        },
        {
          "id": "add",
          "look": "form",
          "show": {
            "mode": "inline"
          },
          "tools": [
            {
              "as": "submit",
              "label": {
                "en": "Add",
                "zh": "添加",
                "fr": "Ajouter"
              },
              "do": "create",
              "table": "$table.checklist",
              "ask": ["name", "due"]
            }
          ]
        },
        {
          "id": "papers",
          "look": "checklist",
          "source": {
            "table": "$table.checklist",
            "sort": {
              "field": "due",
              "direction": "asc"
            },
            "limit": 50
          },
          "show": {
            "title": "name",
            "subtitles": ["due"],
            "emptyText": {
              "en": "Add the papers you need, such as a passport photo or a bank statement.",
              "zh": "把要准备的材料加进来，例如证件照、银行流水。",
              "fr": "Ajoutez les pièces à fournir : photo d’identité, relevé bancaire…"
            }
          },
          "tools": [
            {
              "as": "check",
              "do": "toggle",
              "table": "$table.checklist",
              "field": "ready"
            }
          ]
        },
        {
          "id": "to-ids",
          "look": "entry",
          "show": {
            "title": {
              "en": "My IDs",
              "zh": "我的证件",
              "fr": "Mes papiers"
            },
            "subtitle": {
              "en": "Expiry dates and scans of your passport and ID card",
              "zh": "护照、身份证的到期日和扫描件",
              "fr": "Dates d’expiration et copies du passeport et de la carte d’identité"
            },
            "icon": "person"
          },
          "opens": "page:$page.ids"
        },
        {
          "id": "actions",
          "look": "group",
          "show": {
            "title": {
              "en": "For your application",
              "zh": "办证用得上",
              "fr": "Pour votre demande"
            },
            "layout": "stack"
          },
          "children": [
            {
              "id": "run-scan-paper",
              "look": "action",
              "show": {
                "shape": "row"
              },
              "tools": [
                {
                  "tool": "$tool.scanPaper"
                }
              ]
            },
            {
              "id": "run-photo",
              "look": "action",
              "show": {
                "shape": "row"
              },
              "tools": [
                {
                  "tool": "$tool.photo"
                }
              ]
            },
            {
              "id": "run-print-photos",
              "look": "action",
              "show": {
                "shape": "row"
              },
              "tools": [
                {
                  "tool": "$tool.printPhotos"
                }
              ]
            },
            {
              "id": "run-packet",
              "look": "action",
              "show": {
                "shape": "row"
              },
              "tools": [
                {
                  "tool": "$tool.packet"
                }
              ]
            },
            {
              "id": "run-to-english",
              "look": "action",
              "show": {
                "shape": "row"
              },
              "tools": [
                {
                  "tool": "$tool.toEnglish"
                }
              ]
            },
            {
              "id": "run-foreign-pdf",
              "look": "action",
              "show": {
                "shape": "row"
              },
              "tools": [
                {
                  "tool": "$tool.foreignPdf"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "$page.ids",
      "title": {
        "en": "My IDs",
        "zh": "我的证件",
        "fr": "Mes papiers"
      },
      "icon": "person",
      "blocks": [
        {
          "id": "title",
          "look": "header",
          "show": {
            "title": {
              "en": "My IDs",
              "zh": "我的证件",
              "fr": "Mes papiers"
            },
            "subtitle": {
              "en": "Morph reminds you 30 days before a document expires.",
              "zh": "证件到期前 30 天，Morph 会提醒你。",
              "fr": "Morph vous prévient 30 jours avant l’expiration d’un document."
            }
          }
        },
        {
          "id": "scans",
          "look": "group",
          "show": {
            "layout": "grid",
            "columns": 2
          },
          "children": [
            {
              "id": "passport-scan",
              "look": "entry",
              "show": {
                "title": {
                  "en": "Passport scan",
                  "zh": "护照扫描件",
                  "fr": "Copie du passeport"
                },
                "hint": {
                  "en": "Tap to choose the file",
                  "zh": "点一下选文件",
                  "fr": "Touchez pour choisir le fichier"
                },
                "icon": "document",
                "shape": "tile"
              },
              "opens": {
                "file": null
              }
            },
            {
              "id": "id-card-scan",
              "look": "entry",
              "show": {
                "title": {
                  "en": "ID card scan",
                  "zh": "身份证扫描件",
                  "fr": "Copie de la carte d’identité"
                },
                "hint": {
                  "en": "Tap to choose the file",
                  "zh": "点一下选文件",
                  "fr": "Touchez pour choisir le fichier"
                },
                "icon": "document",
                "shape": "tile"
              },
              "opens": {
                "file": null
              }
            }
          ]
        },
        {
          "id": "documents",
          "look": "list",
          "source": {
            "table": "$table.documents",
            "sort": {
              "field": "expires",
              "direction": "asc"
            },
            "limit": 30
          },
          "show": {
            "title": "name",
            "subtitles": ["expires"],
            "emptyText": {
              "en": "Add your passport and visa with their expiry dates.",
              "zh": "把护照、签证和到期日加进来。",
              "fr": "Ajoutez votre passeport et votre visa avec leur date d’expiration."
            }
          }
        },
        {
          "id": "add",
          "look": "button",
          "show": {
            "label": {
              "en": "Add a document",
              "zh": "添加证件",
              "fr": "Ajouter un document"
            },
            "variant": "filled"
          },
          "tools": [
            {
              "do": "create",
              "table": "$table.documents",
              "ask": "all"
            }
          ]
        }
      ]
    }
  ],
  "main": "$page.main",
  "entry": "nav"
}
