{
  "icon": "lightbulb",
  "name": {
    "en": "Study helper",
    "zh": "学习助手",
    "fr": "Assistant d’études"
  },
  "summary": {
    "en": "Homework sorted by deadline, plus quick actions for recordings, handouts and notes.",
    "zh": "作业按截止日期排好，录音转文字、扫讲义、合资料一点就行。",
    "fr": "Les devoirs triés par date limite, et des actions rapides pour les enregistrements, les polycopiés et les notes."
  },
  "ids": {
    "$table.homework": "homework",
    "$page.main": "study",
    "$tool.photoLog": "homework-photo-log",
    "$tool.due": "homework-due",
    "$tool.review": "daily-review"
  },
  "tables": [
    {
      "id": "$table.homework",
      "name": {
        "en": "Homework",
        "zh": "作业",
        "fr": "Devoirs"
      },
      "icon": "bookmark",
      "fields": [
        {
          "id": "title",
          "name": {
            "en": "Assignment",
            "zh": "作业",
            "fr": "Devoir"
          },
          "type": "text",
          "required": true
        },
        {
          "id": "course",
          "name": {
            "en": "Course",
            "zh": "课程",
            "fr": "Cours"
          },
          "type": "choice",
          "options": [
            {
              "id": "math",
              "label": {
                "en": "Math",
                "zh": "数学",
                "fr": "Maths"
              }
            },
            {
              "id": "language",
              "label": {
                "en": "English",
                "zh": "语文",
                "fr": "Français"
              }
            },
            {
              "id": "foreign",
              "label": {
                "en": "Foreign language",
                "zh": "外语",
                "fr": "Langue étrangère"
              }
            },
            {
              "id": "science",
              "label": {
                "en": "Science",
                "zh": "科学",
                "fr": "Sciences"
              }
            },
            {
              "id": "other",
              "label": {
                "en": "Other",
                "zh": "其他",
                "fr": "Autre"
              }
            }
          ]
        },
        {
          "id": "due",
          "name": {
            "en": "Due",
            "zh": "截止日期",
            "fr": "À rendre le"
          },
          "type": "date"
        },
        {
          "id": "done",
          "name": {
            "en": "Done",
            "zh": "完成",
            "fr": "Fait"
          },
          "type": "checkbox"
        },
        {
          "id": "file",
          "name": {
            "en": "Attachment",
            "zh": "附件",
            "fr": "Pièce jointe"
          },
          "type": "file"
        }
      ]
    }
  ],
  "tools": [
    {
      "id": "$tool.photoLog",
      "kind": "quickAction",
      "name": {
        "en": "Snap an assignment and add it",
        "zh": "拍下作业记一项",
        "fr": "Photographier un devoir et l’ajouter"
      },
      "icon": "photo",
      "steps": [
        {
          "id": "pick",
          "action": "in.photos",
          "params": {
            "source": "camera",
            "min": 1,
            "max": 5
          }
        },
        {
          "id": "log",
          "action": "out.addRecord",
          "params": {
            "collectionId": "$table.homework"
          }
        }
      ]
    },
    {
      "id": "$tool.toText",
      "preset": "audio-to-text"
    },
    {
      "id": "$tool.mergeAudio",
      "preset": "merge-recordings"
    },
    {
      "id": "$tool.archiveAudio",
      "preset": "voice-memo-archive"
    },
    {
      "id": "$tool.scan",
      "preset": "scan-document"
    },
    {
      "id": "$tool.combine",
      "preset": "combine-documents"
    },
    {
      "id": "$tool.due",
      "kind": "reminder",
      "title": {
        "en": "Homework is due tomorrow",
        "zh": "明天要交作业了",
        "fr": "Un devoir est à rendre demain"
      },
      "enabled": true,
      "when": {
        "before": {
          "table": "$table.homework",
          "field": "due"
        },
        "days": 1,
        "at": "18:00"
      },
      "opens": "page:$page.main"
    },
    {
      "id": "$tool.review",
      "kind": "reminder",
      "title": {
        "en": "Take ten minutes to review today’s lessons",
        "zh": "花十分钟复习一下今天学的",
        "fr": "Prenez dix minutes pour revoir les cours du jour"
      },
      "enabled": true,
      "when": {
        "every": "day",
        "at": "21:00"
      },
      "opens": "page:$page.main"
    }
  ],
  "pages": [
    {
      "id": "$page.main",
      "title": {
        "en": "Study",
        "zh": "学习",
        "fr": "Études"
      },
      "icon": "lightbulb",
      "blocks": [
        {
          "id": "title",
          "look": "header",
          "show": {
            "title": {
              "en": "Study helper",
              "zh": "学习助手",
              "fr": "Assistant d’études"
            },
            "subtitle": {
              "en": "Homework in deadline order. Recordings and handouts sorted in one tap.",
              "zh": "作业按截止日期排好，录音和讲义一点就整理好。",
              "fr": "Les devoirs par date limite. Enregistrements et polycopiés rangés en un appui."
            }
          }
        },
        {
          "id": "summary",
          "look": "group",
          "show": {
            "layout": "row"
          },
          "children": [
            {
              "id": "open",
              "look": "number",
              "show": {
                "label": {
                  "en": "To do",
                  "zh": "未完成",
                  "fr": "À faire"
                }
              },
              "source": {
                "table": "$table.homework",
                "aggregate": "count",
                "filter": [
                  {
                    "field": "done",
                    "op": "is",
                    "value": false
                  }
                ]
              }
            },
            {
              "id": "done-week",
              "look": "number",
              "show": {
                "label": {
                  "en": "Done this week",
                  "zh": "本周完成",
                  "fr": "Faits cette semaine"
                }
              },
              "source": {
                "table": "$table.homework",
                "aggregate": "count",
                "filter": [
                  {
                    "field": "done",
                    "op": "is",
                    "value": true
                  },
                  {
                    "field": "updatedAt",
                    "op": "inPeriod",
                    "value": "thisWeek"
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "add",
          "look": "form",
          "show": {
            "mode": "inline"
          },
          "tools": [
            {
              "as": "submit",
              "label": {
                "en": "Add",
                "zh": "添加",
                "fr": "Ajouter"
              },
              "do": "create",
              "table": "$table.homework",
              "ask": ["title", "due"]
            }
          ]
        },
        {
          "id": "todo",
          "look": "checklist",
          "source": {
            "table": "$table.homework",
            "filter": [
              {
                "field": "done",
                "op": "is",
                "value": false
              }
            ],
            "sort": {
              "field": "due",
              "direction": "asc"
            },
            "limit": 50
          },
          "show": {
            "title": "title",
            "subtitles": ["course", "due"],
            "emptyText": {
              "en": "All done. Add the next assignment above.",
              "zh": "作业都做完了，有新作业就在上面添加。",
              "fr": "Tout est fait. Ajoutez le prochain devoir ci-dessus."
            }
          },
          "tools": [
            {
              "as": "check",
              "do": "toggle",
              "table": "$table.homework",
              "field": "done"
            }
          ]
        },
        {
          "id": "actions",
          "look": "group",
          "show": {
            "title": {
              "en": "Recordings and handouts",
              "zh": "录音和讲义",
              "fr": "Enregistrements et polycopiés"
            },
            "layout": "stack"
          },
          "children": [
            {
              "id": "run-photo-log",
              "look": "action",
              "show": {
                "shape": "row"
              },
              "tools": [
                {
                  "tool": "$tool.photoLog"
                }
              ]
            },
            {
              "id": "run-to-text",
              "look": "action",
              "show": {
                "shape": "row"
              },
              "tools": [
                {
                  "tool": "$tool.toText"
                }
              ]
            },
            {
              "id": "run-merge-audio",
              "look": "action",
              "show": {
                "shape": "row"
              },
              "tools": [
                {
                  "tool": "$tool.mergeAudio"
                }
              ]
            },
            {
              "id": "run-archive-audio",
              "look": "action",
              "show": {
                "shape": "row"
              },
              "tools": [
                {
                  "tool": "$tool.archiveAudio"
                }
              ]
            },
            {
              "id": "run-scan",
              "look": "action",
              "show": {
                "shape": "row"
              },
              "tools": [
                {
                  "tool": "$tool.scan"
                }
              ]
            },
            {
              "id": "run-combine",
              "look": "action",
              "show": {
                "shape": "row"
              },
              "tools": [
                {
                  "tool": "$tool.combine"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "main": "$page.main",
  "entry": "nav"
}
