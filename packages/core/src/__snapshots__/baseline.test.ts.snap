exports[`baseline > workspace config JSON Schema 1`] = `
"
.
<oneOf filePick> object
<oneOf filePick>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf filePick>.hidden? boolean
<oneOf filePick>.style? object
<oneOf filePick>.style.align? "start"|"center"
<oneOf filePick>.style.tone? "default"|"primary"|"secondary"|"tertiary"|"muted"
<oneOf filePick>.style.size? "small"|"medium"|"large"
<oneOf filePick>.style.backdrop? object
<oneOf filePick>.style.backdrop.overlay "light"|"medium"|"strong"
<oneOf filePick>.style.backdrop.assetId? string /^[a-z0-9]{6,40}$/
<oneOf filePick>.type "filePick"
<oneOf filePick>.props object
<oneOf filePick>.props.source "media"|"files"
<oneOf header> object
<oneOf header>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf header>.hidden? boolean
<oneOf header>.style? = <oneOf filePick>.style
<oneOf header>.type "header"
<oneOf header>.props object
<oneOf header>.props.title string len 1..60
<oneOf header>.props.subtitle? string len 1..120
<oneOf text> object
<oneOf text>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf text>.hidden? boolean
<oneOf text>.style? = <oneOf filePick>.style
<oneOf text>.type "text"
<oneOf text>.props object
<oneOf text>.props.text string len 1..1500
<oneOf toolCard> object
<oneOf toolCard>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf toolCard>.hidden? boolean
<oneOf toolCard>.style? = <oneOf filePick>.style
<oneOf toolCard>.type "toolCard"
<oneOf toolCard>.props object
<oneOf toolCard>.props.toolId string /^[a-z][a-z0-9-]{0,47}$/
<oneOf toolCard>.props.look? "row"|"tile"
<oneOf toolGrid> object
<oneOf toolGrid>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf toolGrid>.hidden? boolean
<oneOf toolGrid>.style? = <oneOf filePick>.style
<oneOf toolGrid>.type "toolGrid"
<oneOf toolGrid>.props object
<oneOf toolGrid>.props.title? string len 1..60
<oneOf toolGrid>.props.toolIds? array items 1..30
<oneOf toolGrid>.props.toolIds[] string /^[a-z][a-z0-9-]{0,47}$/
<oneOf catalogLink> object
<oneOf catalogLink>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf catalogLink>.hidden? boolean
<oneOf catalogLink>.style? = <oneOf filePick>.style
<oneOf catalogLink>.type "catalogLink"
<oneOf catalogLink>.props object
<oneOf catalogLink>.props.title string len 1..60
<oneOf catalogLink>.props.look? "row"|"tile"
<oneOf fileList> object
<oneOf fileList>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf fileList>.hidden? boolean
<oneOf fileList>.style? = <oneOf filePick>.style
<oneOf fileList>.type "fileList"
<oneOf fileList>.props object
<oneOf fileList>.props.title string len 1..60
<oneOf fileList>.props.limit integer 1..50
<oneOf fileList>.props.mimeType? "application/pdf"|"image/*"|"video/*"|"audio/*"
<oneOf workflowRunner> object
<oneOf workflowRunner>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf workflowRunner>.hidden? boolean
<oneOf workflowRunner>.style? = <oneOf filePick>.style
<oneOf workflowRunner>.type "workflowRunner"
<oneOf workflowRunner>.props object
<oneOf workflowRunner>.props.workflowId string /^[a-z][a-z0-9-]{0,47}$/
<oneOf workflowRunner>.props.look? "card"|"row"|"tile"
<oneOf quickActionList> object
<oneOf quickActionList>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf quickActionList>.hidden? boolean
<oneOf quickActionList>.style? = <oneOf filePick>.style
<oneOf quickActionList>.type "quickActionList"
<oneOf quickActionList>.props object
<oneOf quickActionList>.props.title? string len 1..60
<oneOf quickActionList>.props.kind? "image"|"video"|"audio"|"document"|"other"
<oneOf button> object
<oneOf button>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf button>.hidden? boolean
<oneOf button>.style? = <oneOf filePick>.style
<oneOf button>.type "button"
<oneOf button>.props object
<oneOf button>.props.label string len 1..40
<oneOf button>.props.target?
<oneOf button>.props.action?
<oneOf button>.props.action<oneOf 0> object
<oneOf button>.props.action<oneOf 0>.do "create"
<oneOf button>.props.action<oneOf 0>.collectionId string /^[a-z][a-z0-9-]{0,47}$/
<oneOf button>.props.action<oneOf 0>.values? object record
<oneOf button>.props.action<oneOf 0>.values{}
<oneOf button>.props.action<oneOf 0>.values{}<anyOf 0> string /^[a-z][a-z0-9-]{0,47}$/
<oneOf button>.props.action<oneOf 0>.values{}<anyOf 1> "$record"
<oneOf button>.props.action<oneOf 0>.values{}<anyOf 2> number
<oneOf button>.props.action<oneOf 0>.values{}<anyOf 3> boolean
<oneOf button>.props.action<oneOf 0>.values{}<anyOf 4> null
<oneOf button>.props.action<oneOf 0>.form? true
<oneOf button>.props.action<oneOf 1> object
<oneOf button>.props.action<oneOf 1>.do "setAll"
<oneOf button>.props.action<oneOf 1>.collectionId string /^[a-z][a-z0-9-]{0,47}$/
<oneOf button>.props.action<oneOf 1>.filter? array items ..5
<oneOf button>.props.action<oneOf 1>.filter[] object
<oneOf button>.props.action<oneOf 1>.filter[].field
<oneOf button>.props.action<oneOf 1>.filter[].field<anyOf 0> string /^[a-z][a-z0-9-]{0,47}$/
<oneOf button>.props.action<oneOf 1>.filter[].field<anyOf 1> "createdAt"|"updatedAt"
<oneOf button>.props.action<oneOf 1>.filter[].op "is"|"isNot"|"contains"|"gt"|"lt"|"isEmpty"|"isNotEmpty"|"inPeriod"|"due"
<oneOf button>.props.action<oneOf 1>.filter[].value?
<oneOf button>.props.action<oneOf 1>.filter[].value<anyOf 0> string len ..200
<oneOf button>.props.action<oneOf 1>.filter[].value<anyOf 1> number
<oneOf button>.props.action<oneOf 1>.filter[].value<anyOf 2> boolean
<oneOf button>.props.action<oneOf 1>.fieldId string /^[a-z][a-z0-9-]{0,47}$/
<oneOf button>.props.action<oneOf 1>.value = <oneOf button>.props.action<oneOf 0>.values{}
<oneOf button>.props.action<oneOf 2> object
<oneOf button>.props.action<oneOf 2>.do "open"
<oneOf button>.props.action<oneOf 2>.collectionId string /^[a-z][a-z0-9-]{0,47}$/
<oneOf button>.props.variant "filled"|"outline"|"text"|"icon"
<oneOf button>.props.icon?
<oneOf button>.props.icon<anyOf 0> "home"|"apps"|"sparkles"|"history"|"settings"|"document"|"folder"|"star"|"heart"|"bolt"|"calendar"|"bookmark"|"inbox"|"chart"|"check"|"info"|"lightbulb"|"merge"|"link"|"person"|"plus"|"search"|"photo"|"scan"|"text"|"qrcode"|"archive"|"printer"|"signature"|"workflow"|"video"|"audio"|"translate"|"note"
<oneOf button>.props.icon<anyOf 1> string
<oneOf shortcut> object
<oneOf shortcut>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf shortcut>.hidden? boolean
<oneOf shortcut>.style? = <oneOf filePick>.style
<oneOf shortcut>.type "shortcut"
<oneOf shortcut>.props object
<oneOf shortcut>.props.title string len 1..40
<oneOf shortcut>.props.subtitle? string len 1..80
<oneOf shortcut>.props.icon = <oneOf button>.props.icon
<oneOf shortcut>.props.target
<oneOf shortcut>.props.look? "row"|"tile"
<oneOf notice> object
<oneOf notice>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf notice>.hidden? boolean
<oneOf notice>.style? = <oneOf filePick>.style
<oneOf notice>.type "notice"
<oneOf notice>.props object
<oneOf notice>.props.title? string len 1..60
<oneOf notice>.props.text string len 1..600
<oneOf notice>.props.icon? = <oneOf button>.props.icon
<oneOf image> object
<oneOf image>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf image>.hidden? boolean
<oneOf image>.style? = <oneOf filePick>.style
<oneOf image>.type "image"
<oneOf image>.props object
