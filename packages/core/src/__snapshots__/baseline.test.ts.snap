exports[`baseline > workspace config JSON Schema 1`] = `
"
.
<oneOf 0> object
<oneOf 0>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 0>.hidden? boolean
<oneOf 0>.style? object
<oneOf 0>.style.align? "start"|"center"
<oneOf 0>.style.tone? "default"|"primary"|"secondary"|"tertiary"|"muted"
<oneOf 0>.style.size? "small"|"medium"|"large"
<oneOf 0>.style.backdrop? object
<oneOf 0>.style.backdrop.overlay "light"|"medium"|"strong"
<oneOf 0>.style.backdrop.assetId? string /^[a-z0-9]{6,40}$/
<oneOf 0>.look "header"
<oneOf 0>.show object
<oneOf 0>.show.title string len 1..60
<oneOf 0>.show.subtitle? string len 1..120
<oneOf 1> object
<oneOf 1>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 1>.hidden? boolean
<oneOf 1>.style? = <oneOf 0>.style
<oneOf 1>.look "text"
<oneOf 1>.show object
<oneOf 1>.show.text string len 1..1500
<oneOf 2> object
<oneOf 2>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 2>.hidden? boolean
<oneOf 2>.style? = <oneOf 0>.style
<oneOf 2>.look "notice"
<oneOf 2>.show object
<oneOf 2>.show.title? string len 1..60
<oneOf 2>.show.text string len 1..600
<oneOf 2>.show.icon?
<oneOf 2>.show.icon<anyOf 0> "home"|"apps"|"sparkles"|"history"|"settings"|"document"|"folder"|"star"|"heart"|"bolt"|"calendar"|"bookmark"|"inbox"|"chart"|"check"|"info"|"lightbulb"|"merge"|"link"|"person"|"plus"|"search"|"photo"|"scan"|"text"|"qrcode"|"archive"|"printer"|"signature"|"workflow"|"video"|"audio"|"translate"|"note"
<oneOf 2>.show.icon<anyOf 1> string
<oneOf 3> object
<oneOf 3>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 3>.hidden? boolean
<oneOf 3>.style? = <oneOf 0>.style
<oneOf 3>.look "image"
<oneOf 3>.show object
<oneOf 3>.show.asset?
<oneOf 3>.show.asset<anyOf 0> string /^[a-z0-9]{6,40}$/
<oneOf 3>.show.asset<anyOf 1> null
<oneOf 3>.show.aspect "wide"|"landscape"|"square"|"portrait"
<oneOf 3>.show.fit "cover"|"contain"
<oneOf 3>.show.caption? string len 1..120
<oneOf 3>.show.placeholder? string len 1..60
<oneOf 4> object
<oneOf 4>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 4>.hidden? boolean
<oneOf 4>.style? = <oneOf 0>.style
<oneOf 4>.look "divider"
<oneOf 4>.show? object
<oneOf 5> object
<oneOf 5>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 5>.hidden? boolean
<oneOf 5>.style? = <oneOf 0>.style
<oneOf 5>.look "spacer"
<oneOf 5>.show object
<oneOf 5>.show.size "small"|"medium"|"large"
<oneOf 6> object
<oneOf 6>.id string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 6>.hidden? boolean
<oneOf 6>.style? = <oneOf 0>.style
<oneOf 6>.look "button"
<oneOf 6>.show object
<oneOf 6>.show.label string len 1..40
<oneOf 6>.show.variant "filled"|"outline"|"text"|"icon"
<oneOf 6>.show.icon? = <oneOf 2>.show.icon
<oneOf 6>.tools? array items 1..1
<oneOf 6>.tools[]
<oneOf 6>.tools[]<anyOf 0> object
<oneOf 6>.tools[]<anyOf 0>.as? "submit"|"button"|"check"|"tap"|"drag"|"addHere"
<oneOf 6>.tools[]<anyOf 0>.label? string len 1..30
<oneOf 6>.tools[]<anyOf 0>.when? array items ..3
<oneOf 6>.tools[]<anyOf 0>.when[] object
<oneOf 6>.tools[]<anyOf 0>.when[].field
<oneOf 6>.tools[]<anyOf 0>.when[].field<anyOf 0> string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 6>.tools[]<anyOf 0>.when[].field<anyOf 1> "createdAt"|"updatedAt"
<oneOf 6>.tools[]<anyOf 0>.when[].op "is"|"isNot"|"contains"|"gt"|"lt"|"isEmpty"|"isNotEmpty"|"inPeriod"|"due"
<oneOf 6>.tools[]<anyOf 0>.when[].value?
<oneOf 6>.tools[]<anyOf 0>.when[].value<anyOf 0> string len ..200
<oneOf 6>.tools[]<anyOf 0>.when[].value<anyOf 1> number
<oneOf 6>.tools[]<anyOf 0>.when[].value<anyOf 2> boolean
<oneOf 6>.tools[]<anyOf 0>.tool
<oneOf 6>.tools[]<anyOf 0>.tool<anyOf 0> string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 6>.tools[]<anyOf 0>.tool<anyOf 1> "$pick.media"|"$pick.files"
<oneOf 6>.tools[]<anyOf 1> object
<oneOf 6>.tools[]<anyOf 1>.as? "submit"|"button"|"check"|"tap"|"drag"|"addHere"
<oneOf 6>.tools[]<anyOf 1>.label? string len 1..30
<oneOf 6>.tools[]<anyOf 1>.when? array items ..3
<oneOf 6>.tools[]<anyOf 1>.when[] = <oneOf 6>.tools[]<anyOf 0>.when[]
<oneOf 6>.tools[]<anyOf 1>.do "create"
<oneOf 6>.tools[]<anyOf 1>.table string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 6>.tools[]<anyOf 1>.values?
<oneOf 6>.tools[]<anyOf 1>.values<anyOf 0> object record
<oneOf 6>.tools[]<anyOf 1>.values<anyOf 0>{}
<oneOf 6>.tools[]<anyOf 1>.values<anyOf 0>{}<anyOf 0> string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 6>.tools[]<anyOf 1>.values<anyOf 0>{}<anyOf 1> "$record"
<oneOf 6>.tools[]<anyOf 1>.values<anyOf 0>{}<anyOf 2> "$row"
<oneOf 6>.tools[]<anyOf 1>.values<anyOf 0>{}<anyOf 3> "$group"
<oneOf 6>.tools[]<anyOf 1>.values<anyOf 0>{}<anyOf 4> number
<oneOf 6>.tools[]<anyOf 1>.values<anyOf 0>{}<anyOf 5> boolean
<oneOf 6>.tools[]<anyOf 1>.values<anyOf 0>{}<anyOf 6> null
<oneOf 6>.tools[]<anyOf 1>.values<anyOf 1> "$here"
<oneOf 6>.tools[]<anyOf 1>.ask?
<oneOf 6>.tools[]<anyOf 1>.ask<anyOf 0> "all"
<oneOf 6>.tools[]<anyOf 1>.ask<anyOf 1> array items 1..10
<oneOf 6>.tools[]<anyOf 1>.ask<anyOf 1>[] string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 6>.tools[]<anyOf 1>.smartDate? object
<oneOf 6>.tools[]<anyOf 1>.smartDate.from string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 6>.tools[]<anyOf 1>.smartDate.to string /^[a-z][a-z0-9-]{0,47}$/
<oneOf 6>.tools[]<anyOf 2> object
<oneOf 6>.tools[]<anyOf 2>.as? "submit"|"button"|"check"|"tap"|"drag"|"addHere"
