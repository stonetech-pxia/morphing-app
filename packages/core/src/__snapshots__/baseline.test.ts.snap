                "limit": 50,
                "sort": {
                  "direction": "desc",
                  "field": "updatedAt",
                },
                "subtitleFields": [
                  "body",
                ],
                "titleField": "title",
              },
              "type": "recordList",
            },
          ],
          "icon": "document",
          "id": "notes",
          "title": "笔记",
        },
      },
      {
        "items": [
          "page:home",
          "page:notes",
          "settings",
        ],
        "op": "setNavItems",
      },
    ],
    "withoutPage": [
      undefined,
      undefined,
      "notes",
    ],
  },
}
`;

