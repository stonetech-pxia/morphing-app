roomyNav.collectionOp.table.icon = "bookmark"
roomyNav.collectionOp.table.fields[0] = {"id":"title","name":"书名","type":"text","required":true}
roomyNav.collectionOp.table.fields[1] = {"id":"author","name":"作者","type":"text"}
roomyNav.collectionOp.table.fields[2].id = "status"
roomyNav.collectionOp.table.fields[2].name = "状态"
roomyNav.collectionOp.table.fields[2].type = "choice"
roomyNav.collectionOp.table.fields[2].options = [{"id":"want","label":"想读"},{"id":"reading","label":"在读"},{"id":"done","label":"读完"}]
roomyNav.collectionOp.table.fields[2].default = "want"
roomyNav.collectionOp.table.fields[3] = {"id":"rating","name":"评分","type":"rating"}
roomyNav.collectionOp.table.fields[4] = {"id":"note","name":"笔记","type":"note"}
roomyNav.pageOps[0].op = "addContainer"
roomyNav.pageOps[0].page.id = "reading-2"
roomyNav.pageOps[0].page.title = "读书清单"
roomyNav.pageOps[0].page.icon = "bookmark"
roomyNav.pageOps[0].page.blocks[0] = {"id":"title","look":"header","show":{"title":"读书清单"}}
roomyNav.pageOps[0].page.blocks[1].id = "finished"
roomyNav.pageOps[0].page.blocks[1].look = "number"
roomyNav.pageOps[0].page.blocks[1].show = {"label":"已读完"}
roomyNav.pageOps[0].page.blocks[1].source = {"table":"existing","aggregate":"count","filter":[{"field":"status","op":"is","value":"done"}]}
roomyNav.pageOps[0].page.blocks[2].id = "add"
roomyNav.pageOps[0].page.blocks[2].look = "button"
roomyNav.pageOps[0].page.blocks[2].show = {"label":"添加一本书","variant":"filled"}
roomyNav.pageOps[0].page.blocks[2].tools = [{"do":"create","table":"existing","ask":"all"}]
roomyNav.pageOps[0].page.blocks[3].id = "books"
roomyNav.pageOps[0].page.blocks[3].look = "cards"
roomyNav.pageOps[0].page.blocks[3].source = {"table":"existing","limit":50}
roomyNav.pageOps[0].page.blocks[3].show = {"title":"title","subtitles":["author","status"],"trailing":"rating","emptyText":"还没有书"}
roomyNav.pageOps[1] = {"op":"updateContainer","nav":{"bar":["page:home","page:reading","page:reading-2","settings"]}}
roomyNav.withoutPage = ["∅undefined","∅undefined","books"]
"
`;

