      {
        "collection": {
          "fields": [
            {
              "id": "title",
              "name": "书名",
              "required": true,
              "type": "text",
            },
            {
              "id": "author",
              "name": "作者",
              "type": "text",
            },
            {
              "default": "want",
              "id": "status",
              "name": "状态",
              "options": [
                {
                  "id": "want",
                  "label": "想读",
                },
                {
                  "id": "reading",
                  "label": "在读",
                },
                {
                  "id": "done",
                  "label": "读完",
                },
              ],
              "type": "choice",
            },
            {
              "id": "rating",
              "name": "评分",
              "type": "rating",
            },
            {
              "id": "note",
              "name": "笔记",
              "type": "note",
            },
          ],
          "icon": "bookmark",
          "id": "books",
          "name": "书单",
        },
        "op": "addCollection",
      },
      {
        "op": "addPage",
        "page": {
          "components": [
            {
              "id": "title",
              "props": {
                "title": "读书清单",
              },
              "type": "header",
            },
            {
              "id": "finished",
              "props": {
                "aggregate": "count",
                "collectionId": "books",
                "filter": [
                  {
                    "field": "status",
                    "op": "is",
                    "value": "done",
                  },
                ],
                "label": "已读完",
              },
              "type": "stat",
            },
            {
              "id": "add",
              "props": {
                "collectionId": "books",
                "fieldIds": [
                  "title",
                  "author",
                  "status",
                ],
                "mode": "button",
                "submitLabel": "添加一本书",
              },
              "type": "recordForm",
            },
            {
              "id": "books",
              "props": {
                "collectionId": "books",
                "display": "cards",
                "emptyText": "还没有书",
                "limit": 50,
                "subtitleFields": [
                  "author",
                  "status",
                ],
                "titleField": "title",
                "trailingField": "rating",
              },
              "type": "recordList",
            },
          ],
          "icon": "bookmark",
          "id": "reading",
          "title": "读书清单",
        },
      },
      {
        "items": [
          "page:home",
          "page:reading",
          "settings",
        ],
        "op": "setNavItems",
      },
    ],
    "withoutPage": [
      undefined,
      undefined,
      "books",
    ],
  },
}
`;

