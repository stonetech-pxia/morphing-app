{
  "ids": {
    "table": "prescription",
    "page": "prescription"
  },
  "table": {
    "id": "$table",
    "name": {
      "en": "Prescriptions",
      "zh": "处方",
      "fr": "Ordonnances"
    },
    "icon": "signature",
    "fields": [
      {
        "id": "name",
        "name": {
          "en": "Name",
          "zh": "名称",
          "fr": "Nom"
        },
        "type": "text"
      },
      {
        "id": "patient",
        "name": {
          "en": "Patient",
          "zh": "患者",
          "fr": "Patient"
        },
        "type": "text"
      },
      {
        "id": "medicine",
        "name": {
          "en": "Medicine",
          "zh": "药品",
          "fr": "Médicament"
        },
        "type": "text"
      },
      {
        "id": "date",
        "name": {
          "en": "Date issued",
          "zh": "开具日期",
          "fr": "Date de prescription"
        },
        "type": "date"
      },
      {
        "id": "attachments",
        "name": {
          "en": "Attachments",
          "zh": "附件",
          "fr": "Pièces jointes"
        },
        "type": "file"
      }
    ]
  },
  "page": {
    "id": "$page",
    "title": {
      "en": "Prescriptions",
      "zh": "处方",
      "fr": "Ordonnances"
    },
    "icon": "signature",
    "blocks": [
      {
        "id": "title",
        "look": "header",
        "show": {
          "title": {
            "en": "Prescriptions",
            "zh": "处方",
            "fr": "Ordonnances"
          }
        }
      },
      {
        "id": "add",
        "look": "button",
        "show": {
          "label": {
            "en": "Add",
            "zh": "添加",
            "fr": "Ajouter"
          },
          "variant": "filled"
        },
        "tools": [
          {
            "do": "create",
            "table": "$table",
            "ask": "all"
          }
        ]
      },
      {
        "id": "entries",
        "look": "list",
        "source": {
          "table": "$table",
          "sort": {
            "field": "name",
            "direction": "desc"
          },
          "limit": 50
        },
        "show": {
          "title": "name",
          "subtitles": ["patient"],
          "emptyText": {
            "en": "Nothing yet",
            "zh": "还没有记录",
            "fr": "Rien pour l’instant"
          }
        }
      }
    ]
  },
  "entry": "nav"
}
