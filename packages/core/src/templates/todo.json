{
  "ids": {
    "table": "todos",
    "page": "todo"
  },
  "table": {
    "id": "$table",
    "name": {
      "en": "To-dos",
      "zh": "待办",
      "fr": "À faire"
    },
    "icon": "check",
    "fields": [
      {
        "id": "title",
        "name": {
          "en": "Task",
          "zh": "事项",
          "fr": "Tâche"
        },
        "type": "text",
        "required": true
      },
      {
        "id": "done",
        "name": {
          "en": "Done",
          "zh": "完成",
          "fr": "Terminé"
        },
        "type": "checkbox"
      },
      {
        "id": "due",
        "name": {
          "en": "Due",
          "zh": "截止日期",
          "fr": "Échéance"
        },
        "type": "date"
      }
    ]
  },
  "page": {
    "id": "$page",
    "title": {
      "en": "To-do",
      "zh": "待办",
      "fr": "À faire"
    },
    "icon": "check",
    "blocks": [
      {
        "id": "title",
        "look": "header",
        "show": {
          "title": {
            "en": "To-do",
            "zh": "待办",
            "fr": "À faire"
          }
        }
      },
      {
        "id": "open-count",
        "look": "number",
        "show": {
          "label": {
            "en": "Open",
            "zh": "未完成",
            "fr": "Non terminées"
          }
        },
        "source": {
          "table": "$table",
          "aggregate": "count",
          "filter": [
            {
              "field": "done",
              "op": "is",
              "value": false
            }
          ]
        }
      },
      {
        "id": "add",
        "look": "form",
        "show": {
          "mode": "inline"
        },
        "tools": [
          {
            "as": "submit",
            "label": {
              "en": "Add",
              "zh": "添加",
              "fr": "Ajouter"
            },
            "do": "create",
            "table": "$table",
            "ask": ["title"]
          }
        ]
      },
      {
        "id": "tasks",
        "look": "checklist",
        "source": {
          "table": "$table",
          "sort": {
            "field": "createdAt",
            "direction": "desc"
          },
          "limit": 50
        },
        "show": {
          "title": "title",
          "subtitles": ["due"],
          "emptyText": {
            "en": "No tasks",
            "zh": "没有待办事项",
            "fr": "Aucune tâche"
          }
        },
        "tools": [
          {
            "as": "check",
            "do": "toggle",
            "table": "$table",
            "field": "done"
          }
        ]
      }
    ]
  },
  "entry": "nav"
}
