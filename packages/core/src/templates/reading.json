{
  "ids": {
    "collection": "books",
    "page": "reading"
  },
  "collection": {
    "id": "$collection",
    "name": {
      "en": "Books",
      "zh": "书单",
      "fr": "Livres"
    },
    "icon": "bookmark",
    "fields": [
      {
        "id": "title",
        "name": {
          "en": "Title",
          "zh": "书名",
          "fr": "Titre"
        },
        "type": "text",
        "required": true
      },
      {
        "id": "author",
        "name": {
          "en": "Author",
          "zh": "作者",
          "fr": "Auteur"
        },
        "type": "text"
      },
      {
        "id": "status",
        "name": {
          "en": "Status",
          "zh": "状态",
          "fr": "Statut"
        },
        "type": "choice",
        "options": [
          {
            "id": "want",
            "label": {
              "en": "Want to read",
              "zh": "想读",
              "fr": "À lire"
            }
          },
          {
            "id": "reading",
            "label": {
              "en": "Reading",
              "zh": "在读",
              "fr": "En cours"
            }
          },
          {
            "id": "done",
            "label": {
              "en": "Finished",
              "zh": "读完",
              "fr": "Lu"
            }
          }
        ],
        "default": "want"
      },
      {
        "id": "rating",
        "name": {
          "en": "Rating",
          "zh": "评分",
          "fr": "Note"
        },
        "type": "rating"
      },
      {
        "id": "note",
        "name": {
          "en": "Notes",
          "zh": "笔记",
          "fr": "Notes"
        },
        "type": "note"
      }
    ]
  },
  "page": {
    "id": "$page",
    "title": {
      "en": "Reading",
      "zh": "读书清单",
      "fr": "Liste de lecture"
    },
    "icon": "bookmark",
    "components": [
      {
        "id": "title",
        "type": "header",
        "props": {
          "title": {
            "en": "Reading",
            "zh": "读书清单",
            "fr": "Liste de lecture"
          }
        }
      },
      {
        "id": "finished",
        "type": "stat",
        "props": {
          "collectionId": "$collection",
          "aggregate": "count",
          "label": {
            "en": "Finished",
            "zh": "已读完",
            "fr": "Terminés"
          },
          "filter": [
            {
              "field": "status",
              "op": "is",
              "value": "done"
            }
          ]
        }
      },
      {
        "id": "add",
        "type": "recordForm",
        "props": {
          "collectionId": "$collection",
          "fieldIds": ["title", "author", "status"],
          "submitLabel": {
            "en": "Add a book",
            "zh": "添加一本书",
            "fr": "Ajouter un livre"
          },
          "mode": "button"
        }
      },
      {
        "id": "books",
        "type": "recordList",
        "props": {
          "collectionId": "$collection",
          "display": "cards",
          "titleField": "title",
          "subtitleFields": ["author", "status"],
          "trailingField": "rating",
          "limit": 50,
          "emptyText": {
            "en": "No books yet",
            "zh": "还没有书",
            "fr": "Aucun livre pour l’instant"
          }
        }
      }
    ]
  },
  "entry": "nav"
}
