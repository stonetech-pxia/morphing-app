{
  "ids": {
    "table": "notes",
    "page": "notes"
  },
  "table": {
    "id": "$table",
    "name": {
      "en": "Notes",
      "zh": "笔记",
      "fr": "Notes"
    },
    "icon": "document",
    "fields": [
      {
        "id": "title",
        "name": {
          "en": "Title",
          "zh": "标题",
          "fr": "Titre"
        },
        "type": "text",
        "required": true
      },
      {
        "id": "body",
        "name": {
          "en": "Text",
          "zh": "正文",
          "fr": "Texte"
        },
        "type": "note"
      }
    ]
  },
  "page": {
    "id": "$page",
    "title": {
      "en": "Notes",
      "zh": "笔记",
      "fr": "Notes"
    },
    "icon": "document",
    "blocks": [
      {
        "id": "title",
        "look": "header",
        "show": {
          "title": {
            "en": "Notes",
            "zh": "笔记",
            "fr": "Notes"
          }
        }
      },
      {
        "id": "add",
        "look": "button",
        "show": {
          "label": {
            "en": "New note",
            "zh": "写笔记",
            "fr": "Nouvelle note"
          },
          "variant": "filled"
        },
        "tools": [
          {
            "do": "create",
            "table": "$table",
            "ask": "all"
          }
        ]
      },
      {
        "id": "notes",
        "look": "cards",
        "source": {
          "table": "$table",
          "sort": {
            "field": "updatedAt",
            "direction": "desc"
          },
          "limit": 50
        },
        "show": {
          "title": "title",
          "subtitles": ["body"],
          "emptyText": {
            "en": "No notes yet",
            "zh": "还没有笔记",
            "fr": "Aucune note pour l’instant"
          }
        }
      }
    ]
  },
  "entry": "nav"
}
